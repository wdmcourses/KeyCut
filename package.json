{
  "name": "keycut",
  "productName": "KeyCut",
  "version": "1.0.0",
  "description": "Fast lossless video editor - cut and export without re-encoding",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "ffmpeg": "node scripts/get-ffmpeg.js",
    "pack": "node scripts/pack.js",
    "test": "electron tests/test-renderer.js",
    "test:keys": "electron tests/test-keys.js",
    "test:scroll": "electron tests/test-scroll.js",
    "test:missing": "electron tests/test-missing.js",
    "test:history": "electron tests/test-history.js",
    "test:panel": "electron tests/test-panel.js",
    "test:runs": "electron tests/test-runs.js",
    "test:export": "electron tests/test-export-folder.js",
    "test:compress": "electron tests/test-compress.js",
    "test:compat": "electron tests/test-compat.js",
    "test:mute": "electron tests/test-mute.js",
    "test:src": "electron tests/test-src-fallback.js",
    "test:ext": "electron tests/test-extensions.js",
    "test:archive": "node tests/test-archive.js",
    "test:tools": "node tests/test-export-tools.js",
    "test:folder": "electron tests/test-folder.js",
    "test:all": "npm run test && npm run test:keys && npm run test:scroll && npm run test:missing && npm run test:history && npm run test:panel && npm run test:runs && npm run test:export && npm run test:compress && npm run test:compat && npm run test:mute && npm run test:src && npm run test:archive && npm run test:tools && npm run test:folder && npm run test:ext"
  },
  "author": "KeyCut",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
